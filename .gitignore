# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# firebase — local deploy cache and CLI debug logs. `firebase.json` and
# `.firebaserc` are committed; everything here is machine-local.
.firebase/
firebase-debug.log*
firestore-debug.log*

# typescript
*.tsbuildinfo
next-env.d.ts

# internal documents dropped in assets/ for reference. Source *artwork* there
# is meant to be committed (assets/Logo.png is the icon master); business and
# planning documents are not.
assets/*.docx
assets/*.pdf
